/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ...pero el ejemplo SI se versiona: es la documentacion de que hace falta.
!.env.example

# respaldos locales: nunca se versionan
respaldos/

# playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/

