# =============================================================================
# Alma Tejida · variables de entorno
#
# Copiar a .env.local y completar. .env* esta en .gitignore: NUNCA se versiona.
# En Vercel se cargan por entorno (Development / Preview / Production).
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Publicas: viajan al navegador. La anon key es publica POR DISENO; lo que
# protege los datos es RLS, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️  SERVIDOR UNICAMENTE. Saltea RLS por completo.
# Si esta clave llega al navegador, toda la seguridad de la aplicacion se cae.
# Solo se lee desde src/lib/supabase/admin.ts, que importa 'server-only'.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio -------------------------------------------------------------------
# URL publica canonica. La usan el sitemap, los metadatos Open Graph y los
# enlaces de los correos. En produccion: https://almatejida.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Instalacion (NO la usa la aplicacion) -----------------------------------
# Cadena de conexion directa a Postgres. La leen solo dos scripts:
#   npm run db:aplicar          crea la base entera
#   npm run admin -- correo     convierte una cuenta en administradora
# Panel de Supabase: Database -> Connection string -> URI -> Session pooler.
# Usar el Session pooler (5432), NO el Transaction pooler (6543).
# Lleva la clave de la base adentro: se puede borrar al terminar de instalar.
SUPABASE_DB_URL=

# --- Tareas programadas ------------------------------------------------------
# Secreto compartido con los cron jobs de Vercel (limpieza de datos viejos y
# ping diario para que el proyecto gratuito de Supabase no se pause).
CRON_SECRET=

# --- Opcional: proteccion antiabuso -----------------------------------------
# Turnstile de Cloudflare. Se activa SOLO si aparece abuso real (punto 160).
# Dejar vacio mantiene los formularios sin captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
